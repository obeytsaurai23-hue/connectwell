# Copy this file to `.env` and fill values for production/staging
# Django
DJANGO_SECRET_KEY=replace-me-with-a-secure-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database (optional) - example Postgres URL
# DATABASE_URL=postgres://user:password@db-host:5432/dbname

# Redis (channels)
# REDIS_URL=redis://:password@redis-host:6379/0

# Payment provider webhook secret (required in production)
YOCO_WEBHOOK_SECRET=replace-with-yoco-secret

# Mock checkout (dev only)
MOCK_CHECKOUT=0
 
# Optional S3 backup settings (for automated backups)
S3_BUCKET=your-backup-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Sentry DSN (optional)
SENTRY_DSN=
